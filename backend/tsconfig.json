{
  "compilerOptions": {
    /* Layout del Progetto */
    "rootDir": "./src",                          
    "outDir": "./dist",                         

    /* Supporto per Node.js Moderno */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": true
  },
  "include": ["src/**/*"], 
  "exclude": ["node_modules"]
}