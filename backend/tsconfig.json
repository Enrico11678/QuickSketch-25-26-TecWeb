{
  "compilerOptions": {
    /* Layout del Progetto */
    "rootDir": "./src",                          
    "outDir": "./dist",                         

    /* Supporto per Node.js Moderno */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"], // Rimuovi le parentesi vuote [] che causavano l'errore

    /* Interoperabilità e Sicurezza */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    /* Generazione Source Map (per il debugging) */
    "sourceMap": true,
    "declaration": true
  },
  "include": ["src/**/*"], // Dice a TS di guardare solo dentro src
  "exclude": ["node_modules"]
}